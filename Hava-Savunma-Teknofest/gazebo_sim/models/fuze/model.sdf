<?xml version="1.0"?>
<sdf version="1.8">
  <model name="fuze">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://fuze/meshes/fuze.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.7 0.15 0.15 1</ambient>
          <diffuse>0.85 0.2 0.2 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.12 0.22 0.50</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
