<?xml version="1.0"?>
<sdf version="1.8">
  <world name="air_defense_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.65 0.75 1</ambient>
      <background>0.53 0.81 0.98 1</background>
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.45 0.30 1</ambient>
            <diffuse>0.40 0.52 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TEKNOFEST Hedef Modelleri -->
    <include>
      <uri>model://fuze</uri>
      <name>fuze_1</name>
      <pose>5.0 -1.8 2.2 0 0 0</pose>
    </include>

    <include>
      <uri>model://helikopter</uri>
      <name>helikopter_1</name>
      <pose>5.0 -0.6 2.2 0 0 1.57</pose>
    </include>

    <include>
      <uri>model://f16</uri>
      <name>f16_1</name>
      <pose>5.0 0.6 2.2 0 0 1.57</pose>
    </include>

    <include>
      <uri>model://drone</uri>
      <name>drone_1</name>
      <pose>5.0 1.8 2.2 0 0 0</pose>
    </include>

    <!-- Yerdeki sanal kamera (hedeflere dogru bakar) -->
    <model name="air_defense_camera">
      <static>true</static>
      <pose>0 0 1.0 0 -0.24 0</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.16 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>0.06 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>200</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>air_defense_camera/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
